; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CPG_CTRL_Y"
run/main_scene="res://scenes/start_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PlayerRecord="*res://scripts/player_record.gd"
GameSettings="*res://scripts/game_settings.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=580
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="ignore"

[gui]

theme/custom="res://assets/fonts/fredoka_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
